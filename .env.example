APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage (used when RECEIPT_STORAGE_DISK / UPLOADS_DISK
# below are set to `s3`). Works with real AWS S3 or an S3-compatible provider
# like Cloudflare R2.
#
# Cloudflare R2 specifically:
#   - AWS_ENDPOINT is your account-level endpoint, e.g.
#     https://<account_id>.r2.cloudflarestorage.com
#   - AWS_DEFAULT_REGION must be `auto`
#   - AWS_USE_PATH_STYLE_ENDPOINT must be `true` — R2 addresses buckets as
#     {endpoint}/{bucket}/{key}, not {bucket}.{endpoint}/{key}. Leaving this
#     false is the most common cause of every S3 write/read 500ing on R2.
#   - AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from an R2 API token
#     (Cloudflare dashboard → R2 → Manage API tokens), not your Cloudflare
#     account credentials.
#   - AWS_URL is only needed if you want business logos to be publicly
#     viewable: enable the bucket's public access (r2.dev subdomain or a
#     custom domain) in the R2 dashboard, then set this to that base URL.
#     PDFs don't need it — they're streamed through the app, not linked directly.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Receipt PDF rendering ---
#
# RECEIPT_RENDERER picks the engine:
#
#   browsershot  (default) — local headless Chrome via Node + puppeteer.
#                Free and fast, but needs the puppeteer npm package AND a
#                Chromium binary in the runtime environment. Fine locally.
#
#   browserless  — POSTs the HTML to a remote headless-Chrome service. Needs
#                only outbound HTTP. REQUIRED on hosts that don't ship
#                node_modules to the runtime container (Laravel Cloud among
#                them) — Browsershot cannot work there at all, and installing
#                puppeteer at deploy time does not persist. Same Chrome under
#                the hood, so receipts look identical.
#
# Works with browserless.io or a self-hosted ghcr.io/browserless/chromium
# container (in which case BROWSERLESS_URL is like http://chrome:3000 and no
# token is needed).
RECEIPT_RENDERER=browsershot
BROWSERLESS_URL=
BROWSERLESS_TOKEN=
BROWSERLESS_TIMEOUT=60

# --- Browsershot-only settings (ignored when RECEIPT_RENDERER=browserless) ---
#
# Browsershot shells out to Node, and that script does `require('puppeteer')`.
# So the puppeteer npm package MUST exist in the runtime environment. A system
# Chrome binary on its own is not sufficient.
#
# Hosts that build front-end assets in a separate container (Laravel Cloud
# among them) ship only public/build to the runtime container, so node_modules
# is absent there and rendering fails with "Cannot find module 'puppeteer'".
#
# Fix on Laravel Cloud — add these as deploy commands:
#   PUPPETEER_CACHE_DIR=/var/www/html/storage/puppeteer npm install puppeteer --omit=dev
# and set the matching env vars below so the app looks in the same places.
# The cache dir MUST match between install time and runtime, or puppeteer
# downloads Chromium to one path and then looks for it in another.

# Optional: explicit path to a Chrome/Chromium binary. Leave blank to let
# puppeteer use the browser it downloads itself.
CHROME_PATH=

# Where the puppeteer package lives. Blank = the app's own node_modules.
BROWSERSHOT_NODE_MODULE_PATH=

# Where puppeteer stores its downloaded Chromium. Blank = ~/.cache/puppeteer,
# which is often not writable or not persisted in a container.
PUPPETEER_CACHE_DIR=

# Disks used for generated PDFs and uploaded business logos. Both default to
# local disk storage, which is fine for a single-instance dev setup but is
# NOT safe on Laravel Cloud (multiple/ephemeral containers don't share local
# disk). In production, set both to `s3` and fill in the AWS_* vars above
# (Laravel Cloud provisions S3-compatible object storage for this; this repo
# has also been tested against Cloudflare R2 — see notes above).
RECEIPT_STORAGE_DISK=local
UPLOADS_DISK=public

VITE_APP_NAME="${APP_NAME}"